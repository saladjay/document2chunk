# Document2Chunk HTTP API（/parse + /parse-pdf，Chai 复杂解析对接）
# 部署到 128.23.67.112，OCR 走宿主 PaddleOCR 服务 :8000
FROM python:3.12-slim

WORKDIR /app

# 系统依赖（PyMuPDF/pdfplumber 需要；LibreOffice 老格式归一化 + 中文字体防豆腐块）
# APT_MIRROR：112 直连 deb.debian.org 仅 ~20KB/s（LibreOffice 全量要数小时）；
# compose 传 mirrors.aliyun.com（实测 1.1MB/s），默认空=不动官方源
ARG APT_MIRROR=""
RUN if [ -n "$APT_MIRROR" ]; then \
        sed -i "s|deb.debian.org|${APT_MIRROR}|g" /etc/apt/sources.list.d/debian.sources; \
    fi \
    && apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 libsm6 libxrender1 libxext6 libgl1 \
    libreoffice-core libreoffice-writer libreoffice-impress \
    fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*

# 源码（openspec/project.md 是 pyproject 的 readme，未入库，建 dummy 占位）
COPY pyproject.toml ./
COPY src ./src
RUN mkdir -p openspec && printf '# document2chunk\n' > openspec/project.md

# 安装（全部 extras：pdf/ocr/docx/api/viz/legacy）；PIP_INDEX_URL 同理走国内镜像
ARG PIP_INDEX_URL=https://pypi.org/simple
RUN pip install --no-cache-dir -i ${PIP_INDEX_URL} ".[pdf,ocr,docx,api,viz,legacy]"

# OCR 服务配置（宿主 PaddleOCR :8000；token 部署时注入）
# 老格式归一化：doc/ppt 等先经 soffice 转 docx（libreoffice-calc 二期再装）
ENV DOCUMENT2CHUNK_OCR_ENDPOINT=http://host.docker.internal:8000 \
    DOCUMENT2CHUNK_OCR_MODEL=vl \
    DOCUMENT2CHUNK_OCR_TIMEOUT=300 \
    DOCUMENT2CHUNK_DOC_TARGET=docx \
    DOCUMENT2CHUNK_SOFFICE_TIMEOUT=120 \
    PYTHONUNBUFFERED=1

EXPOSE 8000

# 启动 HTTP 服务（/parse + /parse-pdf）
CMD ["python", "-m", "document2chunk", "serve", "--host", "0.0.0.0", "--port", "8000"]
